# This file shows the settings that the app and the server need.
# Android emulator reaches a backend on the host using 10.0.2.2.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3001

# Server only. Obtain these from your 42 API v2 application.
FORTYTWO_CLIENT_ID=replace_with_your_42_application_uid
FORTYTWO_CLIENT_SECRET=replace_with_your_42_application_secret
PORT=3001
HOST=127.0.0.1
